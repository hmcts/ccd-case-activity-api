{
	"_guid_": "S-008",
	"_extends_": "F-018_Test_Data_Base",
	"title": "must return a negative response for a malformed case ID on GET Activity",

	"specs": [
		"an active profile in CCD",
		"contains a malformed caseID"
	],

	"operationName": "Get Activity",
	"method": "GET",
	"uri": "/cases/{cid}/activity",
	"request": {
		"pathVariables": {
			"cid": "not-a-number"
		}
	},
	"expectedResponse": {
		"responseCode": 400,
		"headers": {
			"_extends_": "Common_400_Response_Headers"
		},
		"body": {
			"error": "\"Malformed caseId\" must be a number"
		}
	}
}
